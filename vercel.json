{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/automation",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "0 3 * * *"
    }
  ]
}
